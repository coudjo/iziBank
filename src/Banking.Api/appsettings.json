{
  "Jwt": {
    "Issuer": "iziBank",
    "Audience": "iziBank",
    "AccessTokenMinutes": 15,
    "MaxSessionHours": 12
  },
  "Security": {
    "PasswordMinLength": 8,
    "LockoutThreshold": 5,
    "LockoutWindowMinutes": 15,
    "LockoutDurationMinutes": 15,
    "CacheSeconds": 30
  },
  "Supervision": {
    "Enabled": true,
    "AllowSelfApproval": false
  },
  "PartyNumber": {
    "Length": 8
  },
  "AccountNumber": {
    "Length": 13,
    "UseCheckDigit": false
  },
  "Account": {
    "DirectOpeningProductTypes": [
      "SAVINGS",
      "CURRENT"
    ]
  },
  "Kyc": {
    "BeneficialOwnerThresholdPercent": 25,
    "MinimumGroupMembers": 5,
    "MinimumAgeYears": 18
  },
  "Uploads": {
    "MaxImageBytes": 5242880,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "application/pdf"
    ]
  },
  "Calendar": {
    "WeekendDays": [
      "Saturday",
      "Sunday"
    ]
  },
  "Pagination": {
    "MaxPageSize": 100
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Sessions": {
    "SweeperEnabled": true
  }
}
