// Core banking schema
// Source: docs/schema/core-banking.sql plus Phase A section 2 amendments (applied A1-03).
// Where the plan and this file disagree, the plan wins.

Project iziBank {
  database_type: 'SQL Server 2022'
  Note: '''
    Single institution, one shared database.
    Phase A implements the Foundation group only.
    Out-of-scope tables are recorded here so later phases do not invent names.
  '''
}

// ---------------------------------------------------------------------------
// Phase A — in scope
// ---------------------------------------------------------------------------

Table InstitutionProfile {
  InstitutionProfileId int [pk, increment]
  InstitutionName varchar(150) [not null]
  LicenseNumber varchar(30) [unique]
  RegulatoryCategoryId int
  IncorporationDate date
  HeadOfficeAddress nvarchar(300)
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
  Note: 'Singleton - exactly one row per deployment'
}

Table Branch {
  BranchId int [pk, increment]
  BranchCode varchar(10) [not null, unique]
  BranchName varchar(100) [not null]
  OperatingLicenseNo varchar(30)
  ClearingDays smallint
  IsActive bool [not null, default: true]
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table Currency {
  CurrencyId int [pk, increment]
  CurrencyCode varchar(5) [not null, unique]
  CurrencyName varchar(50) [not null]
  ExchangeRate decimal(18,6)
  IsLocalCurrency bool [not null, default: false]
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table BusinessDayStatus {
  BusinessDayStatusId bigint [pk, increment]
  BranchId int [not null]
  WorkingDate date [not null]
  BusinessDayStart datetime
  BusinessDayEnd datetime
  CurrentStatusId int
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table DefinedHoliday {
  HolidayId int [pk, increment]
  HolidayDate date [not null, unique]
  Remarks varchar(100)
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table Module {
  ModuleId int [pk, increment]
  ModuleCode varchar(20) [not null, unique]
  ModuleName varchar(50) [not null]
  HasDataEntry bool [not null, default: false]
  IsActive bool [not null, default: true]
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table SubModule {
  SubModuleId int [pk, increment]
  ModuleId int [not null]
  SubModuleCode varchar(20) [not null, unique]
  SubModuleName varchar(50) [not null]
  IsActive bool [not null, default: true]
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime

  indexes {
    (ModuleId, SubModuleId) [unique, name: 'AK_SubModule_Module_SubModule']
  }
}

Table StaffUser {
  StaffUserId bigint [pk, increment]
  BranchId int [not null]
  StaffCode varchar(20) [not null, unique]
  FullName nvarchar(100) [not null]
  IsTeller bool [not null, default: false]
  TellerGLAccountId bigint
  IsDisabled bool [not null, default: false]
  SecretKeyHash varchar(255)
  CanChangeSecretKey bool
  ChangeKeyAtNextLogOn bool
  SecretKeyChangedOn datetime
  SecretKeyExpiryDays smallint
  CanSwitchBranch bool
  RowVersion blob
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table CustomerDigitalAccess {
  CustomerDigitalAccessId bigint [pk, increment]
  PartyId bigint [not null]
  AccessCode varchar(20) [not null, unique]
  SecretKeyHash varchar(255)
  IsDisabled bool [not null, default: false]
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table RoleGroup {
  RoleGroupId int [pk, increment]
  RoleGroupCode varchar(30) [not null, unique, note: 'Immutable after creation']
  RoleGroupName nvarchar(100) [not null]
  Description nvarchar(300)
  IsSystemGroup bool [not null, default: false, note: 'Seeded groups: editable, not deletable']
  IsActive bool [not null, default: true]
  IsSupervisionRequired bool [not null, default: true]
  SupervisedByUserId bigint
  SupervisedOn datetime
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table RoleGroupPermission {
  RoleGroupPermissionId bigint [pk, increment]
  RoleGroupId int [not null]
  ModuleId int [not null]
  SubModuleId int [note: 'NULL = whole module']
  AllowView bool [not null, default: false]
  AllowAdd bool [not null, default: false]
  AllowEdit bool [not null, default: false]
  AllowDelete bool [not null, default: false]
  AllowSupervise bool [not null, default: false]
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime

  indexes {
    (RoleGroupId, ModuleId, SubModuleId) [unique, name: 'UX_RoleGroupPermission_Group_Module_SubModule']
  }
  Note: 'CK_RoleGroupPermission_ViewImplied: any of Add/Edit/Delete/Supervise requires AllowView. Composite FK (ModuleId, SubModuleId) to SubModule. Union across groups, no deny rows.'
}

Table StaffUserRoleGroup {
  StaffUserRoleGroupId bigint [pk, increment]
  StaffUserId bigint [not null]
  RoleGroupId int [not null]
  BranchId int [not null]
  IsSupervisionRequired bool [not null, default: true]
  SupervisedByUserId bigint
  SupervisedOn datetime
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime

  indexes {
    (StaffUserId, RoleGroupId, BranchId) [unique, name: 'UX_StaffUserRoleGroup_Staff_Group_Branch']
    (BranchId, RoleGroupId) [name: 'IX_StaffUserRoleGroup_Branch_Group']
  }
}

Table IdempotencyKey {
  IdempotencyKeyId bigint [pk, increment]
  KeyValue varchar(100) [not null]
  StaffUserId bigint [not null]
  Route varchar(200) [not null]
  RequestHash varchar(64) [not null]
  ResponseStatus int [not null]
  ResponseBody nvarchar(max)
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ExpiresOn datetime [not null]

  indexes {
    (StaffUserId, KeyValue) [unique, name: 'UX_IdempotencyKey_Staff_Key']
    ExpiresOn [name: 'IX_IdempotencyKey_ExpiresOn']
  }
  Note: 'Not audited. Purged after ExpiresOn (24 hours).'
}

Table UserSession {
  SessionId bigint [pk, increment]
  StaffUserId bigint
  CustomerDigitalAccessId bigint
  LoginAt datetime [not null]
  LogoutAt datetime
  LogoutReasonId int
  IPAddress varchar(45)
  DeviceInfo varchar(200)
  Note: 'Exactly one of StaffUserId / CustomerDigitalAccessId must be set (CHECK constraint)'
}

Table EventType {
  EventTypeId int [pk, increment]
  EventCode varchar(30) [not null, unique]
  EventName varchar(100) [not null]
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table UserActivityLog {
  EventId bigint [pk, increment]
  SessionId bigint [note: 'Nullable so failed logins can be recorded before a session exists']
  BranchId int
  EventTypeId int [not null]
  EntityType varchar(50)
  EntityId varchar(50)
  Outcome varchar(10) [not null]
  EventTimestamp datetime [not null]
  RequestDetailsJson nvarchar(max)
  Note: 'LEDGER - append-only, partitioned by month'
}

Table DataChangeAuditLog {
  AuditId bigint [pk, increment]
  StaffUserId bigint
  BranchId int
  TableName varchar(100) [not null]
  RecordId varchar(50)
  ActionType varchar(10) [not null]
  OldValueJson nvarchar(max)
  NewValueJson nvarchar(max)
  LoggedOn datetime [not null]
  Note: 'LEDGER - append-only, partitioned by month'
}

Table Party {
  PartyId bigint [pk, increment]
  PartyNumber varchar(20) [not null, unique]
  DisplayName nvarchar(200) [not null]
  PartyTypeId int [not null]
  Address1 nvarchar(200)
  Address2 nvarchar(200)
  Phone varchar(20)
  Mobile varchar(20)
  EmailAddress varchar(100)
  KYCStatusId int
  SourceOfFunds varchar(200)
  OccupationOrSector varchar(100)
  IsPoliticallyExposed bool [not null, default: false]
  CreditOfficerId bigint
  IsSupervisionRequired bool [not null, default: false]
  SupervisedByUserId bigint
  SupervisedOn datetime
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table IndividualDetail {
  PartyId bigint [pk]
  Title nvarchar(10)
  FirstName nvarchar(60) [not null]
  LastName nvarchar(60) [not null]
  GenderId int
  DateOfBirth date
  Nationality varchar(50)
  IdentificationTypeId int
  IdentificationNumber varchar(30)
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table BusinessDetail {
  PartyId bigint [pk]
  BusinessName nvarchar(150) [not null]
  RegistrationNumber varchar(40) [unique]
  TaxIdentificationNumber varchar(30)
  IncorporationDate date
  BusinessCategoryId int
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table GroupDetail {
  PartyId bigint [pk]
  GroupName nvarchar(100) [not null]
  FormationDate date
  MeetingFrequency varchar(30)
  ChairpersonPartyId bigint
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table GroupMember {
  GroupMemberId bigint [pk, increment]
  GroupPartyId bigint [not null]
  MemberPartyId bigint [not null]
  GroupMemberRoleId int
  JoinedOn date
  LeftOn date
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table PartyBeneficialOwner {
  PartyBeneficialOwnerId bigint [pk, increment]
  BusinessPartyId bigint [not null]
  OwnerPartyId bigint [not null]
  OwnershipPercentage decimal(5,2)
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table PartyIdentificationDocument {
  PartyIdentificationDocumentId bigint [pk, increment]
  PartyId bigint [not null]
  DocumentTypeId int [not null]
  DocumentNumber varchar(40) [not null]
  ImageValue varbinary(max)
  IssuedOn date
  ExpiresOn date
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table PartyImage {
  PartyId bigint [pk]
  ImageValue varbinary(max)
  IsSupervisionRequired bool [not null, default: false]
  SupervisedByUserId bigint
  SupervisedOn datetime
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table PartySignature {
  PartySignatureId bigint [pk, increment]
  PartyId bigint [not null]
  ImageValue varbinary(max) [not null, note: 'PNG']
  CapturedOn datetime [not null]
  CapturedByUserId bigint [not null]
  IsSupervisionRequired bool [not null, default: true]
  SupervisedByUserId bigint
  SupervisedOn datetime
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime

  indexes {
    (PartyId, SupervisedOn) [name: 'IX_PartySignature_PartyId_SupervisedOn']
  }
  Note: 'Effective specimen = most recent supervised row. Image never returned in lists or written to the change audit.'
}

Table PartyNextOfKin {
  PartyNextOfKinId bigint [pk, increment]
  PartyId bigint [not null]
  FullName nvarchar(100) [not null]
  Relationship varchar(40)
  MobileNumber varchar(20)
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table PartyRegulatoryAttribute {
  PartyRegulatoryAttributeId bigint [pk, increment]
  PartyId bigint [not null]
  AttributeCode varchar(50) [not null]
  AttributeValue varchar(500)
  RecordedOn datetime [not null]
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table CreditOfficer {
  CreditOfficerId bigint [pk, increment]
  BranchId int [not null]
  StaffUserId bigint [not null]
  IsDisabled bool [not null, default: false]
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table Product {
  ProductId int [pk, increment]
  BranchId int [not null]
  ProductCode varchar(10) [not null, unique]
  ProductName varchar(100) [not null]
  ProductTypeId int [not null]
  AccountPrefix varchar(6) [not null]
  CurrencyId int [not null]
  LedgerControlAccountId bigint
  CreditInterestRate decimal(9,4)
  DebitInterestRate decimal(9,4)
  MinimumBalance decimal(19,4)
  AccountsPerCustomer smallint
  IsFreezed bool
  IsChequeBookAllowed bool
  IsActive bool [not null, default: true]
  IsSupervisionRequired bool [not null, default: false]
  SupervisedByUserId bigint
  SupervisedOn datetime
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table ProductInterestRate {
  ProductInterestRateId bigint [pk, increment]
  ProductId int [not null]
  RateTypeId int
  MinimumAmount decimal(19,4)
  MaximumAmount decimal(19,4)
  InterestRate decimal(9,4) [not null]
  EffectiveFrom date [not null]
  EffectiveTo date
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table Account {
  AccountId bigint [pk, increment]
  AccountNumber varchar(20) [not null, unique]
  BranchId int [not null]
  ProductId int [not null]
  AccountName nvarchar(150) [not null]
  DateOpened date [not null]
  OpenedByUserId bigint
  OperatingModeId int
  ClosedOn datetime
  ClosedByUserId bigint
  CloseReasonId int
  IsDormant bool [not null, default: false]
  IsSupervisionRequired bool [not null, default: false]
  SupervisedByUserId bigint
  SupervisedOn datetime
  RowVersion blob
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table AccountHolder {
  AccountHolderId bigint [pk, increment]
  AccountId bigint [not null]
  PartyId bigint [not null]
  AccountHolderRoleId int [not null]
  OperatingInstructionId int
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table AccountBalance {
  AccountId bigint [pk]
  OpeningBalance decimal(19,4) [not null, default: false]
  ClearBalance decimal(19,4) [not null, default: false]
  FreezedAmount decimal(19,4) [not null, default: false]
  UnsupervisedCredit decimal(19,4) [not null, default: false]
  UnsupervisedDebit decimal(19,4) [not null, default: false]
  OverdrawLimit decimal(19,4) [not null, default: false]
  AvailableBalance decimal(19,4) [not null, default: false]
  TotalBalance decimal(19,4) [not null, default: false]
  LastCreditTransactionDate datetime
  LastDebitTransactionDate datetime
  RowVersion blob
}

Table AccountBalanceDailySnapshot {
  SnapshotId bigint [pk, increment]
  AccountId bigint [not null]
  SnapshotDate date [not null]
  ClosingBalance decimal(19,4) [not null]
}

Table AccountClassification {
  AccountClassificationId int [pk, increment]
  ClassificationCode varchar(10) [not null, unique]
  ClassificationName varchar(100) [not null]
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table AccountSubClassification {
  AccountSubClassificationId int [pk, increment]
  AccountClassificationId int [not null]
  SubClassificationCode varchar(10) [not null, unique]
  SubClassificationName varchar(100) [not null]
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table AccountClassificationAssignment {
  AssignmentId bigint [pk, increment]
  AccountId bigint [not null]
  AccountClassificationId int [not null]
  AccountSubClassificationId int
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table AccountCondition {
  AccountId bigint [pk]
  IsFreezed bool [not null, default: false]
  DoNotAllowCredit bool [not null, default: false]
  DoNotAllowDebit bool [not null, default: false]
  CreditLimit decimal(19,4)
  DebitLimit decimal(19,4)
  SuperviseAllTransactions bool [not null, default: false]
  DoNotApplyTransactionCharges bool [not null, default: false]
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table AccountReminder {
  AccountReminderId bigint [pk, increment]
  AccountId bigint [not null]
  ReminderText varchar(200) [not null]
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table DormantAccountHistory {
  DormantHistoryId bigint [pk, increment]
  AccountId bigint [not null]
  ActivatedByUserId bigint
  DateActivated datetime [not null]
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table FreezeReleaseAccountBalance {
  FreezeReleaseId bigint [pk, increment]
  AccountId bigint [not null]
  FreezeReleaseActionId int [not null]
  Amount decimal(19,4)
  Remarks varchar(200)
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table LedgerAccount {
  LedgerAccountId bigint [pk, increment]
  BranchId int [not null]
  LedgerAccountCode varchar(20) [not null, unique]
  AccountName varchar(100) [not null]
  LedgerAccountTypeId int
  CurrencyId int
  Balance decimal(19,4) [not null, default: false]
  IsSupervisionRequired bool [not null, default: true]
  SupervisedByUserId bigint
  SupervisedOn datetime
  RowVersion blob
  CreatedByUserId bigint
  CreatedOn datetime [not null, default: `SYSUTCDATETIME()`]
  ModifiedByUserId bigint
  ModifiedOn datetime
}

Table RegulatoryCategoryType {
  Id int [pk, increment]
  Code varchar(30) [not null, unique]
  Name varchar(100) [not null]
  IsActive bool [not null, default: true]
}

Table BusinessDayStatusType {
  Id int [pk, increment]
  Code varchar(30) [not null, unique]
  Name varchar(100) [not null]
  IsActive bool [not null, default: true]
}

Table LogoutReasonType {
  Id int [pk, increment]
  Code varchar(30) [not null, unique]
  Name varchar(100) [not null]
  IsActive bool [not null, default: true]
}

Table PartyType {
  Id int [pk, increment]
  Code varchar(30) [not null, unique]
  Name varchar(100) [not null]
  IsActive bool [not null, default: true]
}

Table KYCStatusType {
  Id int [pk, increment]
  Code varchar(30) [not null, unique]
  Name varchar(100) [not null]
  IsActive bool [not null, default: true]
}

Table GenderType {
  Id int [pk, increment]
  Code varchar(30) [not null, unique]
  Name varchar(100) [not null]
  IsActive bool [not null, default: true]
}

Table IdentificationDocumentType {
  Id int [pk, increment]
  Code varchar(30) [not null, unique]
  Name varchar(100) [not null]
  IsActive bool [not null, default: true]
}

Table BusinessCategoryType {
  Id int [pk, increment]
  Code varchar(30) [not null, unique]
  Name varchar(100) [not null]
  IsActive bool [not null, default: true]
}

Table GroupMemberRoleType {
  Id int [pk, increment]
  Code varchar(30) [not null, unique]
  Name varchar(100) [not null]
  IsActive bool [not null, default: true]
}

Table ProductType {
  Id int [pk, increment]
  Code varchar(30) [not null, unique]
  Name varchar(100) [not null]
  IsActive bool [not null, default: true]
}

Table RateType {
  Id int [pk, increment]
  Code varchar(30) [not null, unique]
  Name varchar(100) [not null]
  IsActive bool [not null, default: true]
}

Table AccountHolderRoleType {
  Id int [pk, increment]
  Code varchar(30) [not null, unique]
  Name varchar(100) [not null]
  IsActive bool [not null, default: true]
}

Table OperatingInstructionType {
  Id int [pk, increment]
  Code varchar(30) [not null, unique]
  Name varchar(100) [not null]
  IsActive bool [not null, default: true]
}

Table OperatingModeType {
  Id int [pk, increment]
  Code varchar(30) [not null, unique]
  Name varchar(100) [not null]
  IsActive bool [not null, default: true]
}

Table CloseReasonType {
  Id int [pk, increment]
  Code varchar(30) [not null, unique]
  Name varchar(100) [not null]
  IsActive bool [not null, default: true]
}

Table FreezeReleaseActionType {
  Id int [pk, increment]
  Code varchar(30) [not null, unique]
  Name varchar(100) [not null]
  IsActive bool [not null, default: true]
}

Table LedgerAccountType {
  Id int [pk, increment]
  Code varchar(30) [not null, unique]
  Name varchar(100) [not null]
  IsActive bool [not null, default: true]
}

// ---------------------------------------------------------------------------
// Later phases — do not create in Phase A
// ---------------------------------------------------------------------------

Table ChargeCode {
  ChargeId int [pk, increment]
  Code varchar(10) [not null, unique]
  Description varchar(100)
  ChargeCategoryId int
  IsActive bool [not null, default: true]
}

Table ProductCharge {
  ProductChargeId bigint [pk, increment]
  ProductId int [not null]
  ChargeId int [not null]
  ChargeConditionId int
  FreeTransactions smallint
  EffectiveFrom date [not null]
  EffectiveTo date
}

Table ProductChargeTier {
  ProductChargeTierId bigint [pk, increment]
  ProductChargeId bigint [not null]
  TierNumber smallint [not null]
  ChargeBasisId int
  TransactionAmount decimal(19,4)
  AmountOrPercentage decimal(19,4)
  MinimumCharge decimal(19,4)
  MaximumCharge decimal(19,4)
}

Table TransactionCode {
  TransactionCodeId int [pk, increment]
  Code varchar(10) [not null, unique]
  Description varchar(100)
  TransactionCategoryId int
  CreditOrDebit char(1) [not null]
  DefaultNarration varchar(100)
  IsSystemCode bool [not null, default: false]
}

Table TransactionCodeChargeTier {
  TransactionCodeChargeTierId bigint [pk, increment]
  TransactionCodeId int [not null]
  TierNumber smallint [not null]
  ChargeBasisId int
  Amount decimal(19,4)
  Percentage decimal(9,4)
  IncomeLedgerAccountId bigint
}

Table AccountLedgerEntry {
  LedgerEntryId bigint [pk, increment]
  AccountId bigint [not null]
  TransactionCodeId int [not null]
  Amount decimal(19,4) [not null]
  CreditOrDebit char(1) [not null]
  EntryDate date [not null]
  VoucherId varchar(20)
  TellerLedgerAccountId bigint
  ReversesEntryId bigint
  EntryStatusId int [not null]
  OperatorStaffUserId bigint
  SupervisorStaffUserId bigint
  Note: 'LEDGER - append-only, partitioned by EntryDate (monthly)'
}

Table LedgerEntry {
  LedgerEntryId bigint [pk, increment]
  LedgerAccountId bigint [not null]
  TransactionCodeId int [not null]
  Amount decimal(19,4) [not null]
  CrDb char(1) [not null]
  EntryDate date [not null]
  ReversesEntryId bigint
  EntryStatusId int [not null]
  OperatorStaffUserId bigint
  SupervisorStaffUserId bigint
  Note: 'LEDGER - append-only, partitioned by EntryDate (monthly)'
}

Table PendingInterBranchEntry {
  PendingEntryId bigint [pk, increment]
  AccountId bigint [not null]
  ProductId int
  Amount decimal(19,4) [not null]
  CrDb char(1) [not null]
  TransactionCodeId int
  OtherBranchId int [not null]
  OtherBranchAccountId bigint
  EntryStatusId int
}

Table SavedTransferEntry {
  SavedTransferEntryId bigint [pk, increment]
  BranchId int [not null]
  AccountId bigint [not null]
  ProductId int
  Amount decimal(19,4) [not null]
  CrDb char(1) [not null]
  TransactionCodeId int
  EntryStatusId int
}

Table LoanApplication {
  LoanApplicationId bigint [pk, increment]
  BranchId int [not null]
  PartyId bigint [not null]
  ProductId int [not null]
  CreditOfficerId bigint
  DebitAccountId bigint
  LoanAccountId bigint
  AppliedAmount decimal(19,4) [not null]
  InterestRate decimal(9,4)
  TermMonths smallint
  RepaymentFrequencyId int
  ApplicationDate date [not null]
  LoanPurposeId int
  ApplicationStatusId int [not null]
  AppliedByUserId bigint
}

Table LoanApproval {
  LoanApprovalId bigint [pk, increment]
  LoanApplicationId bigint [not null]
  ApprovedAmount decimal(19,4)
  InterestRate decimal(9,4)
  TermMonths smallint
  DecisionId int [not null]
  RejectedReason varchar(200)
  DecidedByUserId bigint
  DecidedOn datetime
}

Table Loan {
  LoanId bigint [pk, increment]
  BranchId int [not null]
  AccountId bigint [not null]
  LoanApplicationId bigint
  LoanSeries smallint
  LoanAmount decimal(19,4) [not null]
  InterestRate decimal(9,4)
  OutstandingPrincipal decimal(19,4)
  OutstandingInterest decimal(19,4)
  DisbursedOn date
  DisbursedByUserId bigint
  LoanStatusId int [not null]
  DebitAccountId bigint
  IsSupervisionRequired bool [not null, default: false]
  SupervisedByUserId bigint
  SupervisedOn datetime
  IsPaidOff bool [not null, default: false]
  ClosedOn datetime
}

Table LoanInstallmentSchedule {
  InstallmentId bigint [pk, increment]
  LoanId bigint [not null]
  InstallmentNumber smallint [not null]
  InstallmentDueOn date [not null]
  PrincipalAmount decimal(19,4)
  InterestAmount decimal(19,4)
  InstallmentAmount decimal(19,4)
  PrincipalPaid decimal(19,4)
  InterestPaid decimal(19,4)
  PaidOn datetime
  PenaltyAmount decimal(19,4)
  PenaltyPaid decimal(19,4)
}

Table LoanInstallmentScheduleRevision {
  RevisionId bigint [pk, increment]
  InstallmentId bigint [not null]
  RevisionNumber smallint [not null]
  PrincipalAmount decimal(19,4)
  InterestAmount decimal(19,4)
  RevisedOn datetime [not null]
  RevisedByUserId bigint
  RevisionReason varchar(200)
}

Table LoanLevelDetail {
  LoanLevelId int [pk, increment]
  ProductId int [not null]
  LoanLevelCode varchar(10) [not null, unique]
  MaxLoanAmount decimal(19,4)
  MinLoanAmount decimal(19,4)
  MaxInterestRate decimal(9,4)
  MinInterestRate decimal(9,4)
  MaxLoanTermMonths smallint
  EffectiveFrom date [not null]
  EffectiveTo date
}

Table Collateral {
  CollateralId bigint [pk, increment]
  LoanApplicationId bigint [not null]
  PartyId bigint
  CollateralCategoryId int
  Description varchar(100)
  CollateralValue decimal(19,4) [not null]
  ForceSaleValue decimal(19,4)
  StartDate date
  ExpiryDate date
}

Table Guarantor {
  GuarantorId bigint [pk, increment]
  LoanApplicationId bigint [not null]
  GuarantorPartyId bigint [not null]
  WorkingDate date
}

Table PaidOffLoanDetail {
  PaidOffId bigint [pk, increment]
  LoanId bigint [not null]
  PaidOffPrincipal decimal(19,4)
  PaidOffInterest decimal(19,4)
  PaidOffDate date
  PaidOffByUserId bigint
}

Table GroupLoanMemberAllocation {
  AllocationId bigint [pk, increment]
  LoanId bigint [not null]
  MemberPartyId bigint [not null]
  AllocatedAmount decimal(19,4) [not null]
  MemberRepaymentStatusId int
  Note: 'ASSUMPTION - confirm per-member tracking inside a group loan is needed'
}

Table OverdraftApplication {
  OverdraftApplicationId bigint [pk, increment]
  AccountId bigint [not null]
  Amount decimal(19,4) [not null]
  InterestRate decimal(9,4)
  ApplicationStatusId int
}

Table OverdraftApproval {
  OverdraftApprovalId bigint [pk, increment]
  OverdraftApplicationId bigint [not null]
  ApprovedAmount decimal(19,4)
  DecisionId int [not null]
  ApprovedByUserId bigint
}

Table Overdraft {
  OverdraftId bigint [pk, increment]
  AccountId bigint [not null]
  OverdraftApprovalId bigint [not null]
  OverdrawLimit decimal(19,4) [not null]
  ExpiryDate date
}

Table FixedDeposit {
  FixedDepositId bigint [pk, increment]
  BranchId int [not null]
  AccountId bigint [not null]
  LinkedSavingsAccountId bigint
  Amount decimal(19,4) [not null]
  InterestRate decimal(9,4)
  StartDate date
  EndDate date
  MaturityInstructionId int
  StatusId int [not null]
  ProcessedOrCancelledByUserId bigint
  ClosedByUserId bigint
}

Table RepresentingBank {
  RepresentingBankId int [pk, increment]
  RepresentingBankCode varchar(10) [not null, unique]
  RepresentingBankName varchar(100) [not null]
}

Table RepresentingBankBranch {
  RepresentingBankBranchId int [pk, increment]
  RepresentingBankId int [not null]
  SubBranchName varchar(100) [not null]
}

Table OutwardClearing {
  OutwardClearingId bigint [pk, increment]
  BranchId int [not null]
  AccountId bigint [not null]
  RepresentingBankId int
  ChequeNumber varchar(20) [not null]
  Amount decimal(19,4) [not null]
  ChequeDate date
  EntryStatusId int
}

Table InwardClearing {
  InwardClearingId bigint [pk, increment]
  BranchId int [not null]
  AccountId bigint [not null]
  RepresentingBankId int
  ChequeNumber varchar(20) [not null]
  Amount decimal(19,4) [not null]
  EntryStatusId int
}

Table ClearedChequeHistory {
  ClearedChequeId bigint [pk, increment]
  OutwardClearingId bigint
  InwardClearingId bigint
  ClearingDate date [not null]
  Note: 'Exactly one of OutwardClearingId / InwardClearingId must be set (CHECK constraint)'
}

Table StoppedCheque {
  StoppedChequeId bigint [pk, increment]
  AccountId bigint [not null]
  StartNumber varchar(20) [not null]
  EndNumber varchar(20) [not null]
  ReasonAndAction varchar(100)
}

Table ChequeBookRequest {
  ChequeBookRequestId bigint [pk, increment]
  AccountId bigint [not null]
  ChequeBookCategoryId int
  NumberOfLeaves smallint
  RequestStatusId int
}

Table ChequeBookIssued {
  ChequeBookIssuedId bigint [pk, increment]
  AccountId bigint [not null]
  StartNumber varchar(20) [not null]
  EndNumber varchar(20) [not null]
  IssuedOn datetime
}

Table ChequePaid {
  ChequePaidId bigint [pk, increment]
  AccountId bigint [not null]
  ChequeNumber varchar(20) [not null]
  Amount decimal(19,4) [not null]
  PaidOn datetime
  PaidByUserId bigint
}

Table NotificationTemplate {
  NotificationTemplateId int [pk, increment]
  TemplateCode varchar(30) [not null, unique]
  ChannelId int [not null]
  BodyTemplate nvarchar(max)
  IsActive bool [not null, default: true]
}

Table NotificationOutbox {
  NotificationId bigint [pk, increment]
  AccountId bigint
  PartyId bigint
  ChannelId int [not null]
  TemplateId int
  Recipient varchar(150) [not null]
  MessageBody nvarchar(max)
  StatusId int [not null]
  RetryCount smallint [not null, default: false]
  FailureReason varchar(300)
  SentOn datetime
  Note: 'Partitioned by month'
}

Table USSDSession {
  SessionId varchar(50) [pk]
  MobileNumber varchar(20) [not null]
  CustomerDigitalAccessId bigint
  MenuPosition varchar(20)
  CreatedOn datetime [not null]
  ExpiresAt datetime [not null]
}

Table VerificationCode {
  VerificationCodeId bigint [pk, increment]
  BranchId int
  OTPHash varchar(255) [not null]
  MobileNumber varchar(20) [not null]
  CustomerDigitalAccessId bigint
  StatusId int [not null]
  ExpiresAt datetime [not null]
}

Table VerifiedDevice {
  VerifiedDeviceId bigint [pk, increment]
  MobileNumber varchar(20) [not null]
  CustomerDigitalAccessId bigint
  IsVerified bool [not null, default: false]
  IsActive bool [not null, default: true]
  VerifiedOn datetime
}

Table ApiMerchant {
  MerchantId bigint [pk, increment]
  BranchId int [not null]
  MerchantCode varchar(20) [not null, unique]
