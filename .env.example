# Copy to .env and replace placeholder values. Never commit .env.

# SQL Server (docker compose + local tools)
MSSQL_SA_PASSWORD=ChangeMe_DevOnly_1
MSSQL_PORT=14334

# API / Migrator
ConnectionStrings__Banking=Server=localhost,14334;Database=iziBank;User Id=sa;Password=ChangeMe_DevOnly_1;TrustServerCertificate=True;Encrypt=True

# JWT signing key: at least 32 random characters, different in every environment. Generate one with
#   openssl rand -base64 48
# Left empty on purpose: the API refuses to start until a real key is set.
Jwt__SigningKey=

# Bootstrap administrator (Migrator only; not used on API startup)
BOOTSTRAP_ADMIN_CODE=ADMIN
BOOTSTRAP_ADMIN_SECRET=Admin@123
BOOTSTRAP_BRANCH_CODE=001
BOOTSTRAP_BRANCH_NAME=Head Office
