root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,props,csproj,sln}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Language
csharp_style_namespace_declarations = file_scoped:error
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_using_directive_placement = outside_namespace:error
csharp_prefer_braces = true:suggestion
csharp_new_line_before_open_brace = all
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Naming
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.severity = error
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.style = prefix_interface_i
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.prefix_interface_i.required_prefix = I
dotnet_naming_style.prefix_interface_i.capitalization = pascal_case

# Nullable
dotnet_diagnostic.CS8600.severity = error
dotnet_diagnostic.CS8602.severity = error
dotnet_diagnostic.CS8603.severity = error
dotnet_diagnostic.CS8604.severity = error
dotnet_diagnostic.CS8618.severity = error

# Do not require XML docs on every public member
dotnet_diagnostic.CS1591.severity = none

# Entity class names match table names from the schema
[src/Banking.Domain/**/*.cs]
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1716.severity = none

# EF Core scaffolding — do not rewrite generated migrations
[src/Banking.Infrastructure/Persistence/Migrations/**.cs]
generated_code = true
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none

# Test method names may use underscores
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA2007.severity = none
